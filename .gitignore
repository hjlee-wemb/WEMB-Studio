# 저장소에서 항상 제외 (로컬에만 보관) — 안 쓰는 파일 모음
etc/
.impeccable/

# POSCO KDB 생성기의 대조용 캡처 · 임시 파일(수백 장, 약 140MB) — 저장소에는 생성기와 원본 데이터만 올린다
src/posco/_gen/*.png
src/posco/_gen/nul

# LS Electric STATCOM 생성기의 대조용 캡처 · 서버 로그 — 같은 이유로 생성기와 원본 데이터만 올린다
src/lselectric/_gen/*.png
src/lselectric/_gen/*.log

# 신한카드 정보보호 생성기의 대조용 캡처 · 서버 로그 — 같은 이유로 생성기와 원본 데이터만 올린다
src/shinhan/_gen/*.png
src/shinhan/_gen/*.log

# 홍보영상 원본(35MB) — 앱에 쓰이지 않아 로컬에만 보관
*.mp4

# 분자 라이브러리 서버(wemb-atomic) — 자체 저장소 · 원본 사본 수백 MB, 앱 배포에는 src/atomic 내보내기만 쓴다
wemb-atomic/

# 우리은행 통합 대시보드 생성기의 대조용 캡처 · 서버 로그 — 같은 이유로 생성기와 원본 데이터만 올린다
src/woori/_gen/*.png
src/woori/_gen/*.log
src/plant/_gen/*.png
src/plant/_gen/*.log
src/plant-assets/_gen/*.png

# STATCOM HMI 생성기의 대조용 캡처 · 서버 로그
src/statcom/_gen/*.png
src/statcom/_gen/*.log
src/statcom-assets/_gen/*.png

# 신사업 관리 생성기의 대조용 캡처 · 서버 로그(지도 원본 2장은 mk-map-alpha.js 가 쓴다)
src/newbiz/_gen/*.png
!src/newbiz/_gen/korea-map-raw.png
!src/newbiz/_gen/korea-map-lg-raw.png
src/newbiz/_gen/*.log
src/newbiz-assets/_gen/*.png
src/wnms/_gen/*.png
src/wnms/_gen/*.log
src/drawing/_gen/*.png
src/drawing/_gen/*.log
src/drawing-assets/_gen/*.png
src/drawing-assets/_gen/*.log

# 스마트 플랜트 가스 모니터링 생성기의 대조용 캡처 · 글자 상자 · 서버 로그 · 컴파일한 도구 — 생성기와 원본 데이터만 올린다(도구는 mk-light-images.cs 에서 csc 로 다시 만든다)
src/gasmon/_gen/*.png
src/gasmon/_gen/*.log
src/gasmon/_gen/*.exe
src/gasmon/_gen/lboxes-*.json
