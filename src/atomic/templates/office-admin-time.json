c-Text-Wrap\" data-name=\"Text Wrap\" data-node-id=\"2555:5323\">\n                <p id=\"ofmc-Body_2\" class=\"n2555_5324 ofmc-Body\" data-name=\"Body\" data-node-id=\"2555:5324\"><span id=\"ofmc-Node_6\" class=\"x13\">LIVE</span><span id=\"ofmc-Node_7\" class=\"x14\"> 화면의 업데이트 주기를 설정합니다. 해당 주기는 분석 기능에는 영향을 미치지 않습니다.</span></p>\n              </div>\n            </div>\n            <div id=\"ofmc-Item\" class=\"n2555_5325 ofmc-Item\" data-name=\"Item\" data-node-id=\"2555:5325\">\n              <div id=\"ofmc-Label_3\" class=\"n2555_5326 ofmc-Label\" data-name=\"Label\" data-node-id=\"2555:5326\">\n                <p id=\"ofmc-Label_4\" class=\"n2555_5327 ofmc-Label\" data-name=\"Label\" data-node-id=\"2555:5327\">업데이트 주기</p>\n              </div>\n              <div id=\"ofmc-Input\" class=\"n2555_5328 ofmc-Input\" data-name=\"Input\" data-node-id=\"2555:5328\">\n                <p id=\"ofmc-Value\" class=\"n2555_5329 ofmc-Value\" data-name=\"Value\" data-node-id=\"2555:5329\"><span id=\"ofmc-Node_8\" class=\"x15\">1</span><span id=\"ofmc-Node_9\" class=\"x16\">분</span></p>\n              </div>\n            </div>\n          </div>\n          <div id=\"ofmc-Body_3\" class=\"n2555_5330 ofmc-Body\" data-name=\"Body\" data-node-id=\"2555:5330\">\n            <div id=\"ofmc-Header_3\" class=\"n2555_5331 ofmc-Header\" data-name=\"Header\" data-node-id=\"2555:5331\">\n              <p id=\"ofmc-Title_2\" class=\"n2555_5332 ofmc-Title\" data-name=\"Title\" data-node-id=\"2555:5332\">근무시간 설정</p>\n              <div id=\"ofmc-Divider_2\" class=\"n2555_5333 ofmc-Divider\" data-name=\"Divider\" data-node-id=\"2555:5333\">\n                <div id=\"ofmc-Node_10\" class=\"x17\">\n                  <img id=\"ofmc-Asset_8\" class=\"x18\" src=\"src/office/divider-3.svg\" alt=\"\">\n                </div>\n              </div>\n              <div id=\"ofmc-Text Wrap_2\" class=\"n2555_5334 ofmc-Text-Wrap\" data-name=\"Text Wrap\" data-node-id=\"2555:5334\">\n                <div id=\"ofmc-Body_4\" class=\"n2555_5335 ofmc-Body\" data-name=\"Body\" data-node-id=\"2555:5335\">\n                  <p id=\"ofmc-Node_11\" class=\"x19\">근무시간 및 점심시간을 설정합니다. 지정한 근무시간은 분석 기능의 기본 시간 필터로 적용됩니다.</p>\n                  <p id=\"ofmc-Node_12\" class=\"x20\">센서 작동 시간은 설정된 근무시간을 기준으로 자동 제어됩니다. 점심시간은 반드시 근무시간 내에 포함되어야 하며, 해당 시간에는 고스트룸 예약 취소 기능이 적용되지 않습니다.</p>\n                </div>\n              </div>\n            </div>\n            <div id=\"ofmc-Item_2\" class=\"n2555_5336 ofmc-Item\" data-name=\"Item\" data-node-id=\"2555:5336\">\n              <!--wemb:molecule:m0001-->\n              <!--wemb:molecule:m0002-->\n            </div>\n            <div id=\"ofmc-Item_3\" class=\"n2555_5354 ofmc-Item\" data-name=\"Item\" data-node-id=\"2555:5354\">\n              <div id=\"ofmc-Label_8\" class=\"n2555_5355 ofmc-Label\" data-name=\"Label\" data-node-id=\"2555:5355\">\n                <p id=\"ofmc-Label_9\" class=\"n2555_5356 ofmc-Label\" data-name=\"Label\" data-node-id=\"2555:5356\">점심시간</p>\n              </div>\n              <div id=\"ofmc-Input_3\" class=\"n2555_5357 ofmc-Input\" data-name=\"Input\" data-node-id=\"2555:5357\">\n                <p id=\"ofmc-Value_3\" class=\"n2555_5358 ofmc-Value\" data-name=\"Value\" data-node-id=\"2555:5358\"><span id=\"ofmc-Node_22\" class=\"x38\">오전 </span><span id=\"ofmc-Node_23\" class=\"x39\">11</span><span id=\"ofmc-Node_24\" class=\"x40\">시 </span><span id=\"ofmc-Node_25\" class=\"x41\">30</span><span id=\"ofmc-Node_26\" class=\"x42\">분  –  오후 </span><span id=\"ofmc-Node_27\" class=\"x43\">1</span><span id=\"ofmc-Node_28\" class=\"x44\">시 </span><span id=\"ofmc-Node_29\" class=\"x45\">00</span><span id=\"ofmc-Node_30\" class=\"x46\">분</span></p>\n                <div id=\"ofmc-Icon_2\" class=\"n2555_5359 ofmc-Icon\" data-name=\"Icon\" data-node-id=\"2555:5359\">\n                  <img id=\"ofmc-Asset_17\" class=\"x47\" src=\"src/office/icon-14.svg\" alt=\"\">\n                </div>\n              </div>\n    